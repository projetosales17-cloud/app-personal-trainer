rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Controle de "1 licença = 1 usuária": cada conta gerencia seu
    // próprio documento de sessão diretamente pelo app.
    match /sessoes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Status da assinatura Hotmart: só a Cloud Function do webhook
    // (via Admin SDK, que ignora estas regras) pode escrever aqui.
    // O app só pode ler o próprio status.
    match /assinaturas/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Ticket de primeiro acesso (e-mail + código da compra) gravado pelo
    // webhook da Hotmart. Só o endpoint /api/primeiro-acesso (Admin SDK,
    // que ignora estas regras) lê/escreve — o cliente nunca toca aqui.
    match /primeiro_acesso/{uid} {
      allow read, write: if false;
    }

    // Registro/trava por e-mail que serializa a criação de conta no
    // webhook (evita 2 contas pro mesmo comprador quando eventos da
    // Hotmart chegam juntos). Só o Admin SDK do webhook toca aqui.
    match /registro_contas/{chave} {
      allow read, write: if false;
    }

    // Lista de espera do espaço "Sua Loja" — ver SuaLojaRepository. A
    // usuária logada só pode CRIAR o próprio interesse; ninguém lê, edita
    // ou apaga pelo cliente (o fundador lê pelo console).
    match /interesse_sua_loja/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Dados da usuária sincronizados entre aparelhos (anamnese, programa,
    // progresso, check-ins, cargas, diário, preferências) — ver
    // SincronizadorDados. Cada conta lê/escreve só o próprio documento.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Fotos de progresso (uma por documento, data URI base64) — ver
      // ProgressoRepository. Subcoleção não herda a regra do documento pai.
      match /fotos_progresso/{fotoId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Foto de perfil (documento único `foto`, data URI base64) — ver
      // FotoPerfilRepository.
      match /perfil/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
