rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Controle de "1 licença = 1 usuária": cada conta gerencia seu
    // próprio documento de sessão diretamente pelo app.
    match /sessoes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Status da assinatura Hotmart: só a Cloud Function do webhook
    // (via Admin SDK, que ignora estas regras) pode escrever aqui.
    // O app só pode ler o próprio status.
    match /assinaturas/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Ticket de primeiro acesso (e-mail + código da compra) gravado pelo
    // webhook da Hotmart. Só o endpoint /api/primeiro-acesso (Admin SDK,
    // que ignora estas regras) lê/escreve — o cliente nunca toca aqui.
    match /primeiro_acesso/{uid} {
      allow read, write: if false;
    }

    // Dados da usuária sincronizados entre aparelhos (anamnese, programa,
    // progresso, check-ins, cargas, diário, preferências) — ver
    // SincronizadorDados. Cada conta lê/escreve só o próprio documento.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
